ELEVENLABS_API_KEY=replace-with-elevenlabs-api-key
ELEVENLABS_VOICE_ID=replace-with-elevenlabs-voice-id
OPENCLAW_GATEWAY_URL=ws://your-openclaw-gateway.example
OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-token
OPENCLAW_APP_NAME=openclaw-hal-assistant
OPENCLAW_GATEWAY_USERNAME=default-user
OPENCLAW_SESSION_ID=
OPENCLAW_DEFAULT_AGENT_MODEL=
OPENCLAW_WAKE_WORD_ENABLED=true
OPENCLAW_WAKE_WORD=hey luke
OPENCLAW_WAKE_ENGINE=speech_recognition
OPENCLAW_WAKE_WORD_ACCESS_KEY=
OPENCLAW_WAKE_WORD_MODEL_PATH=/porcupine_params.pv
OPENCLAW_WAKE_WORD_KEYWORD_PATH=
OPENCLAW_WAKE_WORD_SENSITIVITY=0.6
OPENCLAW_AGENT_ID=main
OPENCLAW_GATEWAY_TIMEOUT_MS=120000
OPENCLAW_GATEWAY_MAX_RETRY_ATTEMPTS=3
OPENCLAW_API_DOCS_ENABLED=false
OPENCLAW_API_DOCS_TOKEN=
OPENCLAW_API_KEY=
OPENCLAW_RATE_LIMIT=60
OPENCLAW_CHAT_REQUEST_TIMEOUT_MS=120000
LOG_LEVEL=info
